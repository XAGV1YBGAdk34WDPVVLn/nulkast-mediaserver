# Copy to .env and customize for your Linux host
SERVER_NAME=NulKast MediaServer
SERVER_ID=nulkast-mediaserver-01
PORT=8275
JELLYFIN_COMPAT_PORT=8096
JELLYFIN_COMPAT_VERSION=10.11.5
DISCOVERY_PORT=7359

# Set to your server's LAN IP so Xbox/TV auto-discovery advertises the right address
PUBLIC_URL=http://192.168.1.100:8275

# Host paths (media is mounted read-only into the container)
HOST_MEDIA_DIR=/path/to/your/media
HOST_DATA_DIR=./data
HOST_TRANSCODE_DIR=/dev/shm

# Hardware acceleration (Intel Quick Sync / VA-API / AMD VA-API)
# Check your host GIDs with: getent group video render
HW_ACCEL=true
DRI_DEVICE=/dev/dri
VIDEO_GID=44
RENDER_GID=109

# Streaming & Diagnostics
HLS_SEGMENT_SECS=4
IDLE_TIMEOUT_SECS=900
DIAGNOSTICS_ENABLED=true

# Artwork & Genres (works out of the box with zero API keys; TMDB is optional)
ONLINE_ARTWORK=true
TMDB_API_KEY=

# Optional remote deploy settings for scripts/mediaserver_ctl.py
# DEPLOY_HOST=user@192.168.1.100
# REMOTE_DIR=~/nulkast-mediaserver
# SERVER_URL=http://192.168.1.100:8275
